# Copy to .env.local and fill in. NEVER commit .env.local.
# Data layer: if DATABASE_URL is set the app uses Postgres (Supabase);
# otherwise it falls back to the built-in in-memory demo store.
DATABASE_URL=

# Auth
JWT_SECRET=change-me-to-a-long-random-string

# Face verification microservice (face-api/). Empty = registration face checks are skipped with a notice.
# Local run: cd face-api && pip install -r requirements.txt && py -m uvicorn main:app --port 8001
FACE_API_URL=http://127.0.0.1:8001

# Image-moderation sidecar (web/scripts/clip-sidecar.mjs) — NSFW + craft scoring for uploads.
# Local default works when the sidecar runs on this machine. If unreachable, uploads fall
# back to manual review (fail-open, nothing breaks).
IMAGE_SIDECAR_URL=http://127.0.0.1:8091

# OCR provider for artisan ID capture (OCR.space). Empty = OCR step is skipped gracefully.
# helloworld is OCR.space public demo key (rate-limited - get your own free key for production).
OCR_API_KEY=helloworld

# Supabase Storage (product images, profile pictures). Empty = local disk fallback
# (files land in web/public/uploads/, served at /uploads/...; works in dev and on the VPS).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# payments: mock | paymongo
PAYMENTS_MODE=mock
PAYMONGO_SECRET_KEY=

# Email delivery: SMTP first (legacy Gmail app password), then Resend, then console fallback.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=Cultural Marketplace <you@gmail.com>
RESEND_API_KEY=
OTP_FROM_EMAIL=noreply@culturalmarketplace.local

# Public site URL (used in emails / NFC verify links)
NEXT_PUBLIC_SITE_URL=http://localhost:3100
